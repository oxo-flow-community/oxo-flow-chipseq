# oxo-flow-chipseq — ChIP-seq peak calling, QC and differential analysis
#
# oxo-flow port of nf-core/chipseq 2.1.0 (commit 76e2382b6d443db4dc2396e6831d1243256d80b0).
# Default-parameters main execution path only — see README.md fidelity table for
# every divergence and exclusion.

[workflow]
name = "chipseq"
version = "2.1.0"
description = "ChIP-seq peak calling, QC and differential analysis — oxo-flow port of nf-core/chipseq"
# Per-sample metadata table (the samplesheet analogue, upstream
# samplesheet.csv): a TSV whose FIRST column is the sample id (matching
# pair_ids) with an `antibody` column — see test/fixtures/samples.tsv.
# Required for multi-antibody runs (multi_antibody = true); inert when
# multi_antibody = false (the single config.antibody path, byte-identical
# to versions without a metadata table).
metadata_file = "test/fixtures/samples.tsv"
# Only consulted when a --profile is merged: "fill" (default) lets a
# profile set keys the workflow does not declare; "override" REPLACES
# workflow values wholesale. The multi_antibody profile relies on
# override (it must swap the shipped four-sample lists for the full
# eight-sample fixture set). No effect without --profile.
profile_mode = "override"

[defaults]
threads = 1
memory = "6G"

# ---------------------------------------------------------------------------
# Input / reference files (user provides; path relative to the run directory).
# The bwa_index directory must contain the BWA index files (*.amb, *.ann,
# *.bwt, *.pac, *.sa) for the reference FASTA.
# ---------------------------------------------------------------------------
[config]
fasta = "test/fixtures/references/genome.fa"
fai = "test/fixtures/references/genome.fa.fai"
gtf = "test/fixtures/references/genome.gtf"
gene_bed = "test/fixtures/references/gene.bed"
chrom_sizes = "test/fixtures/references/chrom.sizes"
blacklist = "test/fixtures/references/blacklist.bed"
bwa_index = "test/fixtures/references/bwa_index"
raw_dir = "test/fixtures/raw"

# MACS3 genome size. Empty string = derive from read length via khmer
# (faithful to the upstream default).
macs_gsize = ""
read_length = 75

# Sample metadata. pair_ids MUST be kept in sync with [[pairs]] (the oxo-flow
# analogue of the nf-core samplesheet meta.id column). ip_ids lists the samples
# that get peak calling — upstream only runs MACS3 for samples that have a
# control; the port mirrors this with per-pair rules whose {control} input is
# empty for control-only samples and skipped via `optional = true`.
pair_ids = ["S1_REP1", "S1_REP2", "C1_REP1", "C1_REP2"]
ip_ids = ["S1_REP1", "S1_REP2"]
antibody = "H3K4me3"
multiple_groups = false
replicates_exist = true
min_reps_consensus = 1
# Multi-antibody consensus: when true, the consensus chain (MACS3
# consensus, HOMER annotation, boolean annotation, featureCounts,
# DESeq2 QC) runs ONCE PER DISTINCT ANTIBODY over that antibody's IP
# samples, mirroring the upstream groupTuple(by: antibody) grouping —
# the antibody values come from the metadata_file's `antibody` column
# (empty cells = control/input samples, excluded from consensus).
# Requires metadata_file to be set; pair_ids/ip_ids must list ALL
# samples (all antibodies' replicates + their controls). The
# multi_antibody = true profile (profiles/multi_antibody.toml) switches
# the shipped test data to the two-antibody fixture set.
multi_antibody = false

# Read group / trimming
seq_center = ""
trim_nextseq = 0
clip_r1 = 0
clip_r2 = 0
three_prime_clip_r1 = 0
three_prime_clip_r2 = 0

# Alignment / filtering. aligner selects the read aligner: 'bwa' (the nf-core
# default), 'bowtie2', 'chromap' or 'star'. Each mode takes a pre-built index
# (bwa_index directory / bowtie2_index directory / chromap_index file /
# star_index directory, e.g. from the upstream iGenomes bundle) — or derives
# it from the reference FASTA with the gated builders below, mirroring the
# upstream PREPARE_GENOME index branches (make_bwa_index / make_bowtie2_index
# / make_chromap_index / make_star_index; point the corresponding index
# config at the generated results/... path in that case).
aligner = "bwa"
bowtie2_index = ""
chromap_index = ""
star_index = ""
make_star_index = false
bwa_min_score = 0
keep_dups = false
keep_multi_map = false

# Peaks — broad mode is the nf-core default (narrow_peak = false); setting
# narrow_peak = true switches the whole peak chain (MACS3 narrowPeak calling,
# FRiP/annotation/QC, consensus, IGV and MultiQC) to the upstream narrow_peak
# layout.
narrow_peak = false
broad_cutoff = 0.1
macs_fdr = 0
macs_pvalue = 0
save_macs_pileup = false
fragment_size = 0
fingerprint_bins = 500000
multiqc_title = ""

# Reference preparation — ports of the upstream PREPARE_GENOME steps that can
# run on the port's plain reference files (all off by default). When enabled,
# point the corresponding input above at the generated file, e.g.
# gene_bed = "results/genome/gene.bed" with make_gene_bed = true;
# chrom_sizes = "results/genome/chrom.sizes" and
# fai = "results/genome/genome.fa.fai" with make_chrom_sizes = true;
# bwa_index = "results/bwa/index" with make_bwa_index = true;
# bowtie2_index = "results/bowtie2/index" with make_bowtie2_index = true;
# chromap_index = "results/chromap/index/genome.index" with
# make_chromap_index = true.
make_gene_bed = false
make_blacklist_regions = false
make_chrom_sizes = false
make_bwa_index = false
make_bowtie2_index = false
make_chromap_index = false

# Step toggles (mirror the nf-core/chipseq params.skip_* / when gates)
skip_fastqc = false
skip_qc = false
skip_trimming = false
skip_picard_metrics = false
skip_preseq = false
skip_spp = false
skip_plot_profile = false
skip_plot_fingerprint = false
skip_peak_annotation = false
skip_peak_qc = false
skip_consensus_peaks = false
skip_deseq2_qc = false
skip_igv = false
skip_multiqc = false

# ---------------------------------------------------------------------------
# Sample pairs. pair_id names the sample (meta.id), experiment is the
# ChIP/experiment sample and control the matching input sample (empty for
# input-only samples). All reads live under raw/{pair_id}_R{1,2}.fastq.gz.
# ---------------------------------------------------------------------------
[[pairs]]
pair_id = "S1_REP1"
experiment = "S1_REP1"
control = "C1_REP1"

[[pairs]]
pair_id = "S1_REP2"
experiment = "S1_REP2"
control = "C1_REP2"

[[pairs]]
pair_id = "C1_REP1"
experiment = "C1_REP1"

[[pairs]]
pair_id = "C1_REP2"
experiment = "C1_REP2"

# Second antibody replicate set (S2* = H3K27ac, C2* controls) — gated on
# config.multi_antibody so the default single-antibody run is byte-identical
# (pair-level `when` declares no rule instances while the toggle is false;
# the multi_antibody profile flips it and replaces pair_ids/ip_ids).
[[pairs]]
pair_id = "S2_REP1"
experiment = "S2_REP1"
control = "C2_REP1"
when = "config.multi_antibody"

[[pairs]]
pair_id = "S2_REP2"
experiment = "S2_REP2"
control = "C2_REP2"
when = "config.multi_antibody"

[[pairs]]
pair_id = "C2_REP1"
experiment = "C2_REP1"
when = "config.multi_antibody"

[[pairs]]
pair_id = "C2_REP2"
experiment = "C2_REP2"
when = "config.multi_antibody"

# ---------------------------------------------------------------------------
# Rule fragments
# ---------------------------------------------------------------------------
[[include]]
path = "modules/read_qc.oxoflow"
namespace = "qc"

[[include]]
path = "modules/reference.oxoflow"
namespace = "reference"

[[include]]
path = "modules/alignment.oxoflow"
namespace = "align"

[[include]]
path = "modules/filter.oxoflow"
namespace = "filter"

[[include]]
path = "modules/tracks.oxoflow"
namespace = "tracks"

[[include]]
path = "modules/peaks.oxoflow"
namespace = "peaks"

[[include]]
path = "modules/consensus.oxoflow"
namespace = "consensus"

# Multi-antibody variants of the consensus chain — gated on
# config.multi_antibody; the default rules above carry the inverse gate.
[[include]]
path = "modules/consensus_multi.oxoflow"
namespace = "consensus"

[[include]]
path = "modules/report.oxoflow"
namespace = "report"

# Multi-antibody variants of IGV/MultiQC — same gate split.
[[include]]
path = "modules/report_multi.oxoflow"
namespace = "report"
