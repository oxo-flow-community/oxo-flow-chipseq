# Reporting — ports nf-core/chipseq local IGV and MULTIQC modules.
# MultiQC scans the whole results/ tree from the workflow root; the expand_inputs
# list below only wires ordering edges to every MQC-producing rule (the shell does
# not reference {input}). assets/multiqc_config.yml is copied to the run root where
# MultiQC auto-discovers it, mirroring the upstream workdir layout. In narrow_peak
# mode the *_narrow variants below take over (results/igv/narrow_peak and
# results/multiqc/narrow_peak, matching the upstream narrow_peak output layout).

[workflow]
name = "chipseq-report"
version = "2.1.0"
description = "IGV session file and MultiQC report"

[[rules]]
name = "igv"
description = "Create IGV session file (local nf-core/chipseq module)"
input = [
    "{config.fasta}",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{config.antibody}/{config.antibody}.consensus_peaks.bed",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{config.antibody}/{config.antibody}.consensus_peaks.antibody.txt",
]
output = [
    "results/igv/broad_peak/igv_session.xml",
    "results/igv/broad_peak/igv_files_orig.txt",
    "results/genome/genome.fa",
]
shell = """
mkdir -p results/igv/broad_peak results/genome
find results -type f -name "*.bigWig" -exec echo -e "{}\\t0,0,178" \\; > bigwig.igv.txt
find results -type f -name "*Peak" -exec echo -e "{}\\t0,0,178" \\; > peaks.igv.txt
# Avoid error when consensus not produced
find results -type f -name "*.bed" -exec echo -e "{}\\t0,0,178" \\; | { grep "consensus/" || test $? = 1; } > consensus.igv.txt

touch replace_paths.txt
find . -name "*.antibody.txt" -exec cat {} + > replace_paths.txt

cat *.igv.txt > igv_files_orig.txt
cp {config.fasta} results/genome/genome.fa
python3 scripts/igv_files_to_session.py igv_session.xml igv_files_orig.txt replace_paths.txt ../../genome/genome.fa --path_prefix '../../'
mv igv_session.xml igv_files_orig.txt results/igv/broad_peak/
"""
when = "!config.multi_antibody && !config.narrow_peak && !config.skip_igv"
# depends_on intentionally excludes peaks::macs3_callpeak: rule-level edges would reach the
# control callpeak instances, which skip (optional, empty {control}) and would block this rule.
# Peak readiness comes through consensus::macs3_consensus (its outputs are file inputs above).
depends_on = ["tracks::ucsc_bedgraphtobigwig", "consensus::macs3_consensus"]
expand_inputs = [
    { pattern = "results/bwa/merged_library/bigwig/{pair_id}.mLb.clN.bigWig", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/macs3/broad_peak/{pair_id}_peaks.broadPeak", variables = { pair_id = "config.ip_ids" } },
]

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/python:3.8.3"

[[rules]]
name = "igv_narrow"
description = "Create IGV session file (local nf-core/chipseq module, narrow_peak mode)"
input = [
    "{config.fasta}",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{config.antibody}/{config.antibody}.consensus_peaks.bed",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{config.antibody}/{config.antibody}.consensus_peaks.antibody.txt",
]
output = [
    "results/igv/narrow_peak/igv_session.xml",
    "results/igv/narrow_peak/igv_files_orig.txt",
    "results/genome/genome.fa",
]
shell = """
mkdir -p results/igv/narrow_peak results/genome
find results -type f -name "*.bigWig" -exec echo -e "{}\\t0,0,178" \\; > bigwig.igv.txt
find results -type f -name "*Peak" -exec echo -e "{}\\t0,0,178" \\; > peaks.igv.txt
# Avoid error when consensus not produced
find results -type f -name "*.bed" -exec echo -e "{}\\t0,0,178" \\; | { grep "consensus/" || test $? = 1; } > consensus.igv.txt

touch replace_paths.txt
find . -name "*.antibody.txt" -exec cat {} + > replace_paths.txt

cat *.igv.txt > igv_files_orig.txt
cp {config.fasta} results/genome/genome.fa
python3 scripts/igv_files_to_session.py igv_session.xml igv_files_orig.txt replace_paths.txt ../../genome/genome.fa --path_prefix '../../'
mv igv_session.xml igv_files_orig.txt results/igv/narrow_peak/
"""
when = "!config.multi_antibody && config.narrow_peak && !config.skip_igv"
# No peaks::macs3_callpeak_narrow dependency (see igv).
depends_on = ["tracks::ucsc_bedgraphtobigwig", "consensus::macs3_consensus_narrow"]
expand_inputs = [
    { pattern = "results/bwa/merged_library/bigwig/{pair_id}.mLb.clN.bigWig", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/macs3/narrow_peak/{pair_id}_peaks.narrowPeak", variables = { pair_id = "config.ip_ids" } },
]

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/python:3.8.3"

[[rules]]
name = "multiqc_workflow_summary"
description = "Generate the MultiQC Workflow Summary custom content (nf-core paramsSummaryMap/paramsSummaryMultiqc template port)"
output = ["results/multiqc/workflow_summary_mqc.yaml"]
shell = """
ENGINE_VERSION="$(command -v oxo-flow >/dev/null 2>&1 && oxo-flow --version | sed 's/^oxo-flow //' || true)"
[ -n "$ENGINE_VERSION" ] || ENGINE_VERSION="unknown"
python3 scripts/multiqc_workflow_summary.py \\
    --out-dir results/multiqc \\
    --engine-version "$ENGINE_VERSION" \\
    --engine-command "oxo-flow run main.oxoflow" \\
    --config fragment_size={config.fragment_size} \\
    --config seq_center={config.seq_center} \\
    --config read_length={config.read_length} \\
    --config multiqc_title={config.multiqc_title} \\
    --config fasta={config.fasta} \\
    --config gtf={config.gtf} \\
    --config bwa_index={config.bwa_index} \\
    --config bowtie2_index={config.bowtie2_index} \\
    --config chromap_index={config.chromap_index} \\
    --config star_index={config.star_index} \\
    --config gene_bed={config.gene_bed} \\
    --config macs_gsize={config.macs_gsize} \\
    --config blacklist={config.blacklist} \\
    --config clip_r1={config.clip_r1} \\
    --config clip_r2={config.clip_r2} \\
    --config three_prime_clip_r1={config.three_prime_clip_r1} \\
    --config three_prime_clip_r2={config.three_prime_clip_r2} \\
    --config trim_nextseq={config.trim_nextseq} \\
    --config skip_trimming={config.skip_trimming} \\
    --config aligner={config.aligner} \\
    --config keep_dups={config.keep_dups} \\
    --config keep_multi_map={config.keep_multi_map} \\
    --config bwa_min_score={config.bwa_min_score} \\
    --config narrow_peak={config.narrow_peak} \\
    --config broad_cutoff={config.broad_cutoff} \\
    --config macs_fdr={config.macs_fdr} \\
    --config macs_pvalue={config.macs_pvalue} \\
    --config min_reps_consensus={config.min_reps_consensus} \\
    --config save_macs_pileup={config.save_macs_pileup} \\
    --config skip_peak_qc={config.skip_peak_qc} \\
    --config skip_peak_annotation={config.skip_peak_annotation} \\
    --config skip_consensus_peaks={config.skip_consensus_peaks} \\
    --config skip_fastqc={config.skip_fastqc} \\
    --config skip_picard_metrics={config.skip_picard_metrics} \\
    --config skip_preseq={config.skip_preseq} \\
    --config skip_plot_profile={config.skip_plot_profile} \\
    --config skip_plot_fingerprint={config.skip_plot_fingerprint} \\
    --config skip_spp={config.skip_spp} \\
    --config skip_deseq2_qc={config.skip_deseq2_qc} \\
    --config skip_igv={config.skip_igv} \\
    --config skip_multiqc={config.skip_multiqc} \\
    --config skip_qc={config.skip_qc} \\
    --config fingerprint_bins={config.fingerprint_bins} \\
    --config library_ids={config.library_ids} \\
    --config raw_dir={config.raw_dir} \\
    --config chrom_sizes={config.chrom_sizes} \\
    --config fai={config.fai} \\
    --config antibody={config.antibody} \\
    --config multi_antibody={config.multi_antibody} \\
    --config replicates_exist={config.replicates_exist} \\
    --config multiple_groups={config.multiple_groups}
"""
when = "!config.skip_multiqc"

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/python:3.8.3"

[[rules]]
name = "multiqc"
description = "Aggregate QC into a MultiQC report (local nf-core/chipseq module)"
input = [
    "results/multiqc/workflow_summary_mqc.yaml",
    "results/bwa/merged_library/macs3/broad_peak/qc/macs3_annotatePeaks.summary_mqc.tsv",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{config.antibody}/{config.antibody}.consensus_peaks.featureCounts.txt.summary",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{config.antibody}/deseq2/{config.antibody}.consensus_peaks.pca.vals_mqc.tsv",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{config.antibody}/deseq2/{config.antibody}.consensus_peaks.sample.dists_mqc.tsv",
]
output = ["results/multiqc/broad_peak/multiqc_report.html"]
shell = """
MQC_ARGS=""
[ -n "{config.multiqc_title}" ] && MQC_ARGS="--title {config.multiqc_title}"
mkdir -p results/multiqc/broad_peak
cp assets/multiqc_config.yml multiqc_config.yml
multiqc -f $MQC_ARGS .
# Publish the report plus the data/plots directories (upstream publishDir
# copies multiqc_data/ and multiqc_plots/ into results/multiqc/).
mv multiqc_report.html results/multiqc/broad_peak/
# Stale multiqc_data/plots from a previous run block the mv (resume moves the
# declared report file aside but not these directories) — clear them first.
[ -d results/multiqc/broad_peak/multiqc_data ] && rm -rf results/multiqc/broad_peak/multiqc_data results/multiqc/broad_peak/multiqc_plots
[ -d multiqc_data ] && mv multiqc_data multiqc_plots results/multiqc/broad_peak/
"""
when = "!config.multi_antibody && !config.narrow_peak && !config.skip_multiqc"
depends_on = [
    "report::multiqc_workflow_summary",
    "qc::fastqc",
    "qc::trimgalore",
    "align::stats_align",
    "align::flagstat_align",
    "align::idxstats_align",
    "align::star_align",
    "align::markduplicates",
    "align::stats_markdup",
    "align::flagstat_markdup",
    "align::idxstats_markdup",
    "filter::stats_filter",
    "filter::flagstat_filter",
    "filter::idxstats_filter",
    "filter::picard_collectmultiplemetrics",
    "filter::preseq",
    "filter::phantompeakqualtools",
    "filter::multiqc_custom_phantompeakqualtools",
    "tracks::deeptools_plotprofile",
    # The plotFingerprint/MQC expand_inputs below already edge to the IP instances; rule-level
    # entries for deeptools_plotfingerprint / multiqc_custom_peaks would reach the control
    # instances, which skip (optional, empty {control}) and would block the whole report.
    "consensus::subread_featurecounts",
    "consensus::deseq2_qc",
]
expand_inputs = [
    { pattern = "results/fastqc/zips/{pair_id}_1_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/fastqc/zips/{pair_id}_2_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/trimgalore/fastqc/zips/{pair_id}_1_val_1_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/trimgalore/fastqc/zips/{pair_id}_2_val_2_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/samtools_stats/{pair_id}.Lb.sorted.bam.stats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/samtools_stats/{pair_id}.Lb.sorted.bam.flagstat", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/samtools_stats/{pair_id}.Lb.sorted.bam.idxstats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/log/{pair_id}.Log.final.out", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.mkD.sorted.bam.stats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.mkD.sorted.bam.flagstat", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.mkD.sorted.bam.idxstats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.clN.sorted.bam.stats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.clN.sorted.bam.flagstat", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.clN.sorted.bam.idxstats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/picard_metrics/{pair_id}.mLb.mkD.sorted.MarkDuplicates.metrics.txt", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/picard_metrics/{pair_id}.mLb.clN.sorted.CollectMultipleMetrics.alignment_summary_metrics", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/preseq/{pair_id}.mLb.mkD.lc_extrap.txt", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/phantompeakqualtools/{pair_id}.spp_correlation_mqc.tsv", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/phantompeakqualtools/{pair_id}.spp_nsc_mqc.tsv", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/phantompeakqualtools/{pair_id}.spp_rsc_mqc.tsv", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/deepTools/plotProfile/{pair_id}.mLb.clN.plotProfile.tab", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/deepTools/plotFingerprint/{pair_id}.mLb.clN.plotFingerprint.raw.txt", variables = { pair_id = "config.ip_ids" } },
    { pattern = "results/bwa/merged_library/deepTools/plotFingerprint/{pair_id}.mLb.clN.plotFingerprint.qcmetrics.txt", variables = { pair_id = "config.ip_ids" } },
    { pattern = "results/bwa/merged_library/macs3/broad_peak/qc/{pair_id}.peak_count_mqc.tsv", variables = { pair_id = "config.ip_ids" } },
    { pattern = "results/bwa/merged_library/macs3/broad_peak/qc/{pair_id}.FRiP_mqc.tsv", variables = { pair_id = "config.ip_ids" } },
]

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/multiqc:1.23--pyhdfd78af_0"

[[rules]]
name = "multiqc_narrow"
description = "Aggregate QC into a MultiQC report (local nf-core/chipseq module, narrow_peak mode)"
input = [
    "results/multiqc/workflow_summary_mqc.yaml",
    "results/bwa/merged_library/macs3/narrow_peak/qc/macs3_annotatePeaks.summary_mqc.tsv",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{config.antibody}/{config.antibody}.consensus_peaks.featureCounts.txt.summary",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{config.antibody}/deseq2/{config.antibody}.consensus_peaks.pca.vals_mqc.tsv",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{config.antibody}/deseq2/{config.antibody}.consensus_peaks.sample.dists_mqc.tsv",
]
output = ["results/multiqc/narrow_peak/multiqc_report.html"]
shell = """
MQC_ARGS=""
[ -n "{config.multiqc_title}" ] && MQC_ARGS="--title {config.multiqc_title}"
mkdir -p results/multiqc/narrow_peak
cp assets/multiqc_config.yml multiqc_config.yml
multiqc -f $MQC_ARGS .
mv multiqc_report.html results/multiqc/narrow_peak/
# Stale multiqc_data/plots from a previous run block the mv — clear them first.
[ -d results/multiqc/narrow_peak/multiqc_data ] && rm -rf results/multiqc/narrow_peak/multiqc_data results/multiqc/narrow_peak/multiqc_plots
[ -d multiqc_data ] && mv multiqc_data multiqc_plots results/multiqc/narrow_peak/
"""
when = "!config.multi_antibody && config.narrow_peak && !config.skip_multiqc"
depends_on = [
    "report::multiqc_workflow_summary",
    "qc::fastqc",
    "qc::trimgalore",
    "align::stats_align",
    "align::flagstat_align",
    "align::idxstats_align",
    "align::star_align",
    "align::markduplicates",
    "align::stats_markdup",
    "align::flagstat_markdup",
    "align::idxstats_markdup",
    "filter::stats_filter",
    "filter::flagstat_filter",
    "filter::idxstats_filter",
    "filter::picard_collectmultiplemetrics",
    "filter::preseq",
    "filter::phantompeakqualtools",
    "filter::multiqc_custom_phantompeakqualtools",
    "tracks::deeptools_plotprofile",
    # See multiqc: rule-level entries for the optional per-sample QC rules are dropped in
    # favour of the precise ip_ids-scoped expand_inputs below.
    "consensus::subread_featurecounts_narrow",
    "consensus::deseq2_qc_narrow",
]
expand_inputs = [
    { pattern = "results/fastqc/zips/{pair_id}_1_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/fastqc/zips/{pair_id}_2_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/trimgalore/fastqc/zips/{pair_id}_1_val_1_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/trimgalore/fastqc/zips/{pair_id}_2_val_2_fastqc.zip", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/samtools_stats/{pair_id}.Lb.sorted.bam.stats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/samtools_stats/{pair_id}.Lb.sorted.bam.flagstat", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/samtools_stats/{pair_id}.Lb.sorted.bam.idxstats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/library/log/{pair_id}.Log.final.out", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.mkD.sorted.bam.stats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.mkD.sorted.bam.flagstat", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.mkD.sorted.bam.idxstats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.clN.sorted.bam.stats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.clN.sorted.bam.flagstat", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/samtools_stats/{pair_id}.mLb.clN.sorted.bam.idxstats", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/picard_metrics/{pair_id}.mLb.mkD.sorted.MarkDuplicates.metrics.txt", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/picard_metrics/{pair_id}.mLb.clN.sorted.CollectMultipleMetrics.alignment_summary_metrics", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/preseq/{pair_id}.mLb.mkD.lc_extrap.txt", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/phantompeakqualtools/{pair_id}.spp_correlation_mqc.tsv", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/phantompeakqualtools/{pair_id}.spp_nsc_mqc.tsv", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/phantompeakqualtools/{pair_id}.spp_rsc_mqc.tsv", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/deepTools/plotProfile/{pair_id}.mLb.clN.plotProfile.tab", variables = { pair_id = "config.pair_ids" } },
    { pattern = "results/bwa/merged_library/deepTools/plotFingerprint/{pair_id}.mLb.clN.plotFingerprint.raw.txt", variables = { pair_id = "config.ip_ids" } },
    { pattern = "results/bwa/merged_library/deepTools/plotFingerprint/{pair_id}.mLb.clN.plotFingerprint.qcmetrics.txt", variables = { pair_id = "config.ip_ids" } },
    { pattern = "results/bwa/merged_library/macs3/narrow_peak/qc/{pair_id}.peak_count_mqc.tsv", variables = { pair_id = "config.ip_ids" } },
    { pattern = "results/bwa/merged_library/macs3/narrow_peak/qc/{pair_id}.FRiP_mqc.tsv", variables = { pair_id = "config.ip_ids" } },
]

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/multiqc:1.23--pyhdfd78af_0"
