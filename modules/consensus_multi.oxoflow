# Consensus peaks and quantification — multi-antibody mode.
#
# Mirror of modules/consensus.oxoflow for multi-antibody experiments
# (config.multi_antibody = true), porting the upstream
# BED_CONSENSUS_QUANTIFY_QC_BEDTOOLS_FEATURECOUNTS_DESEQ2 subworkflow's
# groupTuple(by: antibody) grouping. Every rule here fans out ONCE PER
# DISTINCT ANTIBODY via the engine's input_groups + metadata binding
# (Traitome/oxo-flow #234):
#
#   [workflow] metadata_file = a TSV whose first column is the sample id
#               (matching pair_ids) with an `antibody` column
#   input_groups = [{ pattern = "results/.../{sample}...",
#                     group_by = "meta.antibody" }]
#
# creates one instance per antibody whose {input} = the group's files,
# whose {input_group.sample} = the space-joined sample names and whose
# group key binds under the COLUMN name ({antibody}). Metadata-grouped
# instances bind ONLY the group column — {meta.*} is empty inside these
# shells, so every reference below uses the {antibody} binding.
#
# Empty antibody cells (input/control samples) never form a group — the
# consensus chain covers exactly the ChIP samples, like upstream.
# Single-antibody and no-sheet runs keep the default rules in
# modules/consensus.oxoflow (when = "... && !config.multi_antibody").
# In narrow_peak mode the *_narrow_multi rules below take over with the
# upstream narrow_peak layout, exactly like the default *_narrow rules.

[workflow]
name = "chipseq-consensus-multi"
version = "2.1.0"
description = "Consensus peaks per antibody, boolean annotation, featureCounts quantification and DESeq2 QC — multi-antibody mode"

[[rules]]
name = "macs3_consensus_multi"
description = "Consensus peaks across each antibody's IP samples (local nf-core/chipseq module, multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/macs3/broad_peak/{sample}_peaks.broadPeak", group_by = "meta.antibody" },
]
output = [
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.txt",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.txt",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.intersect.txt",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.bed",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.saf",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.intersect.plot.pdf",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.antibody.txt",
]
shell = """
CONS=results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}
NAMES=$(echo {input} | tr ' ' '\\n' | sed 's|.*/||; s|_peaks\\.broadPeak||' | tr '\\n' ',' | sed 's|,$||')
mkdir -p $CONS
sort -T '.' -k1,1 -k2,2n {input} | mergeBed -c 2,3,4,5,6,7,8,9 -o collapse,collapse,collapse,collapse,collapse,collapse,collapse,collapse > $CONS/{antibody}.consensus_peaks.txt
python3 scripts/macs3_merged_expand.py $CONS/{antibody}.consensus_peaks.txt $NAMES $CONS/{antibody}.consensus_peaks.boolean.txt --min_replicates {config.min_reps_consensus}
awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 { print $1, $2, $3, $4, "0", "+" }' $CONS/{antibody}.consensus_peaks.boolean.txt > $CONS/{antibody}.consensus_peaks.bed
echo -e "GeneID\\tChr\\tStart\\tEnd\\tStrand" > $CONS/{antibody}.consensus_peaks.saf
awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 { print $4, $1, $2, $3, "+" }' $CONS/{antibody}.consensus_peaks.boolean.txt >> $CONS/{antibody}.consensus_peaks.saf
Rscript scripts/plot_peak_intersect.r -i $CONS/{antibody}.consensus_peaks.boolean.intersect.txt -o $CONS/{antibody}.consensus_peaks.boolean.intersect.plot.pdf
# printf so the file carries a REAL tab: TOML's \\t reaches the shell
# as a backslash-t and echo prints it literally — igv_files_to_session
# splits replace_paths.txt on tabs (live: 'not enough values to unpack').
printf "%s\\t%s\\n" "{antibody}.consensus_peaks.bed" "$CONS/{antibody}.consensus_peaks.bed" > $CONS/{antibody}.consensus_peaks.antibody.txt
"""
when = "config.multi_antibody && !config.narrow_peak && !config.skip_consensus_peaks && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 1
memory = "6G"
time_limit = "20h"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-2f48cc59b03027e31ead6d383fe1b8057785dd24:5d182f583f4696f4c4d9f3be93052811b383341f-0"

[[rules]]
name = "macs3_consensus_narrow_multi"
description = "Consensus peaks across each antibody's IP samples (local nf-core/chipseq module, narrow_peak + multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/macs3/narrow_peak/{sample}_peaks.narrowPeak", group_by = "meta.antibody" },
]
output = [
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.txt",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.txt",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.intersect.txt",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.bed",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.saf",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.intersect.plot.pdf",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.antibody.txt",
]
shell = """
CONS=results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}
NAMES=$(echo {input} | tr ' ' '\\n' | sed 's|.*/||; s|_peaks\\.narrowPeak||' | tr '\\n' ',' | sed 's|,$||')
mkdir -p $CONS
# narrowPeak has 10 columns; upstream merges 2..10 with collapse x9 and
# tells macs3_merged_expand.py it is a narrowPeak file.
sort -T '.' -k1,1 -k2,2n {input} | mergeBed -c 2,3,4,5,6,7,8,9,10 -o collapse,collapse,collapse,collapse,collapse,collapse,collapse,collapse,collapse > $CONS/{antibody}.consensus_peaks.txt
python3 scripts/macs3_merged_expand.py $CONS/{antibody}.consensus_peaks.txt $NAMES $CONS/{antibody}.consensus_peaks.boolean.txt --min_replicates {config.min_reps_consensus} --is_narrow_peak
awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 { print $1, $2, $3, $4, "0", "+" }' $CONS/{antibody}.consensus_peaks.boolean.txt > $CONS/{antibody}.consensus_peaks.bed
echo -e "GeneID\\tChr\\tStart\\tEnd\\tStrand" > $CONS/{antibody}.consensus_peaks.saf
awk -v FS='\\t' -v OFS='\\t' 'FNR > 1 { print $4, $1, $2, $3, "+" }' $CONS/{antibody}.consensus_peaks.boolean.txt >> $CONS/{antibody}.consensus_peaks.saf
Rscript scripts/plot_peak_intersect.r -i $CONS/{antibody}.consensus_peaks.boolean.intersect.txt -o $CONS/{antibody}.consensus_peaks.boolean.intersect.plot.pdf
printf "%s\\t%s\\n" "{antibody}.consensus_peaks.bed" "$CONS/{antibody}.consensus_peaks.bed" > $CONS/{antibody}.consensus_peaks.antibody.txt
"""
when = "config.multi_antibody && config.narrow_peak && !config.skip_consensus_peaks && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 1
memory = "6G"
time_limit = "20h"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-2f48cc59b03027e31ead6d383fe1b8057785dd24:5d182f583f4696f4c4d9f3be93052811b383341f-0"

[[rules]]
name = "homer_annotate_consensus_multi"
description = "HOMER annotation of each antibody's consensus peaks (nf-core/homer/annotatepeaks, multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.bed", group_by = "antibody" },
]
input = [
    # Released-engine E003 bridge: engines before input_groups
    # (oxo-flow < 0.17) ignore the grouping declaration, so this plain
    # {antibody} entry keeps "{antibody} in output but not in input" from
    # firing. The NEW engine puts the group file FIRST and appends the
    # declared entries after (the bridge entry resolves to the same BED),
    # so {input[0]} is unchanged.
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.bed",
    "{config.fasta}",
    "{config.gtf}",
]
output = ["results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.annotatePeaks.txt"]
shell = """
annotatePeaks.pl {input[0]} {config.fasta} -gid -gtf {config.gtf} -cpu {threads} > {output[0]}
"""
when = "config.multi_antibody && !config.narrow_peak && !config.skip_consensus_peaks && !config.skip_peak_annotation && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/homer:4.11--pl526hc9558a2_3"

[[rules]]
name = "homer_annotate_consensus_narrow_multi"
description = "HOMER annotation of each antibody's consensus peaks (nf-core/homer/annotatepeaks, narrow_peak + multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.bed", group_by = "antibody" },
]
input = [
    # Released-engine E003 bridge (see homer_annotate_consensus_multi).
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.bed",
    "{config.fasta}",
    "{config.gtf}",
]
output = ["results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.annotatePeaks.txt"]
shell = """
annotatePeaks.pl {input[0]} {config.fasta} -gid -gtf {config.gtf} -cpu {threads} > {output[0]}
"""
when = "config.multi_antibody && config.narrow_peak && !config.skip_consensus_peaks && !config.skip_peak_annotation && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/homer:4.11--pl526hc9558a2_3"

[[rules]]
name = "annotate_boolean_peaks_multi"
description = "Add boolean fields to each antibody's annotated consensus peaks (local nf-core/chipseq module, multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.txt", group_by = "antibody" },
]
input = [
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.annotatePeaks.txt",
]
output = ["results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.annotatePeaks.txt"]
shell = """
cut -f2- {input[1]} | awk 'NR==1; NR > 1 {print $0 | "sort -T '.' -k1,1 -k2,2n"}' | cut -f6- > tmp.txt
paste {input[0]} tmp.txt > {output[0]}
"""
when = "config.multi_antibody && !config.narrow_peak && !config.skip_consensus_peaks && !config.skip_peak_annotation && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
docker = "docker.io/library/ubuntu:20.04"

[[rules]]
name = "annotate_boolean_peaks_narrow_multi"
description = "Add boolean fields to each antibody's annotated consensus peaks (local nf-core/chipseq module, narrow_peak + multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.txt", group_by = "antibody" },
]
input = [
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.annotatePeaks.txt",
]
output = ["results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.boolean.annotatePeaks.txt"]
shell = """
cut -f2- {input[1]} | awk 'NR==1; NR > 1 {print $0 | "sort -T '.' -k1,1 -k2,2n"}' | cut -f6- > tmp.txt
paste {input[0]} tmp.txt > {output[0]}
"""
when = "config.multi_antibody && config.narrow_peak && !config.skip_consensus_peaks && !config.skip_peak_annotation && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 2
memory = "12G"

[rules.environment]
docker = "docker.io/library/ubuntu:20.04"

[[rules]]
name = "subread_featurecounts_multi"
description = "Quantify reads in each antibody's consensus peaks with featureCounts (nf-core/subread/featurecounts, multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/{sample}.mLb.clN.sorted.bam", group_by = "meta.antibody" },
]
input = [
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.saf",
]
output = [
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.featureCounts.txt",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.featureCounts.txt.summary",
]
shell = """
mkdir -p results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}
BAMS=$(echo {input} | tr ' ' '\\n' | grep 'mLb.clN.sorted.bam$' | tr '\\n' ' ')
# {input} leads with the group's BAMs, so the SAF is referenced by its
# deterministic {antibody} path, not a positional {input[i]}.
featureCounts -F SAF -O --fracOverlap 0.2 -p -T {threads} -a results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.saf -s 0 -o {output[0]} $BAMS
"""
when = "config.multi_antibody && !config.narrow_peak && !config.skip_consensus_peaks && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/subread:2.0.1--hed695b0_0"

[[rules]]
name = "subread_featurecounts_narrow_multi"
description = "Quantify reads in each antibody's consensus peaks with featureCounts (nf-core/subread/featurecounts, narrow_peak + multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/{sample}.mLb.clN.sorted.bam", group_by = "meta.antibody" },
]
input = [
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.saf",
]
output = [
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.featureCounts.txt",
    "results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.featureCounts.txt.summary",
]
shell = """
mkdir -p results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}
BAMS=$(echo {input} | tr ' ' '\\n' | grep 'mLb.clN.sorted.bam$' | tr '\\n' ' ')
featureCounts -F SAF -O --fracOverlap 0.2 -p -T {threads} -a results/bwa/merged_library/macs3/narrow_peak/consensus/{antibody}/{antibody}.consensus_peaks.saf -s 0 -o {output[0]} $BAMS
"""
when = "config.multi_antibody && config.narrow_peak && !config.skip_consensus_peaks && (config.multiple_groups || config.replicates_exist)"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/subread:2.0.1--hed695b0_0"

[[rules]]
name = "deseq2_qc_multi"
description = "DESeq2 PCA and sample clustering QC per antibody (local nf-core/chipseq module, multi-antibody mode)"
input_groups = [
    { pattern = "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.featureCounts.txt", group_by = "antibody" },
]
input = [
    # Released-engine E003 bridge (see homer_annotate_consensus_multi).
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/{antibody}.consensus_peaks.featureCounts.txt",
    "assets/multiqc/deseq2_pca_header.txt",
    "assets/multiqc/deseq2_clustering_header.txt",
]
output = [
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2/{antibody}.consensus_peaks.pca.vals.txt",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2/{antibody}.consensus_peaks.sample.dists.txt",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2/{antibody}.consensus_peaks.pca.vals_mqc.tsv",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2/{antibody}.consensus_peaks.sample.dists_mqc.tsv",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2/{antibody}.consensus_peaks.plots.pdf",
    "results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2/{antibody}.consensus_peaks.dds.RData",
]
shell = """
mkdir -p results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2
Rscript scripts/deseq2_qc.r --count_file {input[0]} --outdir ./ --outprefix {antibody}.consensus_peaks --cores {threads} --id_col 1 --sample_suffix '.mLb.clN.sorted.bam' --count_col 7 --vst TRUE
sed 's/deseq2_pca/deseq2_pca_1/g' < assets/multiqc/deseq2_pca_header.txt > tmp.txt
sed -i -e 's/DESeq2 /{antibody} DESeq2 /g' tmp.txt
cat tmp.txt {antibody}.consensus_peaks.pca.vals.txt > {antibody}.consensus_peaks.pca.vals_mqc.tsv
sed 's/deseq2_clustering/deseq2_clustering_1/g' < assets/multiqc/deseq2_clustering_header.txt > tmp.txt
sed -i -e 's/DESeq2 /{antibody} DESeq2 /g' tmp.txt
cat tmp.txt {antibody}.consensus_peaks.sample.dists.txt > {antibody}.consensus_peaks.sample.dists_mqc.tsv
mv {antibody}.consensus_peaks.pca.vals.txt {antibody}.consensus_peaks.sample.dists.txt {antibody}.consensus_peaks.pca.vals_mqc.tsv {antibody}.consensus_peaks.sample.dists_mqc.tsv {antibody}.consensus_peaks.plots.pdf {antibody}.consensus_peaks.dds.RData results/bwa/merged_library/macs3/broad_peak/consensus/{antibody}/deseq2/
"""
when = "config.multi_antibody && !config.narrow_peak && !config.skip_consensus_peaks && !config.skip_deseq2_qc && config.multiple_groups && config.replicates_exist"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-8849acf39a43cdd6c839a369a74c0adc823e2f91:ab110436faf952a33575c64dd74615a84011450b-0"

